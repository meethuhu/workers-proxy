{
  // 部署入口。wrangler deploy 直接使用源码，无构建步骤。
  "name": "workers-proxy",
  "main": "worker.js",

  // 固定运行时行为。不写这一项时，wrangler 会用部署当天日期，
  // 导致同一份代码在不同时间部署表现出不同语义。
  "compatibility_date": "2026-10-01",

  // 上游地址不在仓库里配置，部署时通过 --var 注入：
  //   wrangler deploy --var TARGET_ORIGIN:https://example.com
  // 也可以直接在 worker.js 的 DEFAULT_TARGET_ORIGIN 里填写。
  // 两者都没配时，请求会返回 500，而不是静默指向某个默认站点。

  // 打开后可对 console.error 产生的日志做检索，便于排查 502。
  "observability": {
    "enabled": true
  }
}
